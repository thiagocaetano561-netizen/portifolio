                            "@ffmpeg-installer/ffmpeg":  "^1.1.0",
                            "@playwright/test":  "^1.65.0",
                            "@tailwindcss/postcss":  "^4.3.5",
                            "@types/node":  "^26.6.6",
                            "@types/pg":  "^8.23.1",
                            "@types/react":  "^19.3.0",
                            "@types/react-dom":  "^19.3.0",
                            "postcss":  "^8.5.32",
                            "sharp":  "^0.35.5",
                            "tailwindcss":  "^4.3.5",
                            "tsx":  "^4.23.15",
