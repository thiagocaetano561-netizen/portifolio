{
    "name":  "tryggport-dev",
    "version":  "1.0.0",
    "private":  true,
    "description":  "Tryggport Dev Ã¢â‚¬â€ portfÃƒÂ³lio com terminal interativo e uma camada narrativa protegida no servidor.",
    "type":  "module",
    "engines":  {
                    "node":  "\u003e=20.18"
                },
    "scripts":  {
                    "dev":  "next dev",
                    "build":  "next build",
                    "start":  "next start",
                    "typecheck":  "tsc --noEmit",
                    "db:generate":  "drizzle-kit generate",
                    "db:migrate":  "tsx --conditions=react-server scripts/migrate.ts",
                    "db:seed":  "tsx --conditions=react-server scripts/seed.ts",
                    "db:setup":  "npm run db:migrate \u0026\u0026 npm run db:seed",
                    "db:prune":  "tsx --conditions=react-server scripts/prune.ts",
                    "assets":  "node scripts/build-assets.mjs",
                    "test":  "vitest run",
                    "test:watch":  "vitest",
                    "test:e2e":  "playwright test",
                    "audit:bundle":  "tsx --conditions=react-server scripts/audit-bundle.ts",
                    "audit:deps":  "npm audit --omit=dev",
                    "secrets:generate":  "node scripts/generate-secrets.mjs",
                    "verify":  "npm run typecheck \u0026\u0026 npm test \u0026\u0026 npm run build \u0026\u0026 npm run audit:bundle",
                    "db:seed:prod":  "tsx --env-file=.env.production.local --conditions=react-server scripts/seed.ts",
                    "env:prod":  "node scripts/prepare-production-env.mjs"
                },
    "dependencies":  {
                         "@electric-sql/pglite":  "^0.5.16",
                         "drizzle-orm":  "^0.45.4",
