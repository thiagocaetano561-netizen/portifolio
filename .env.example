# -----------------------------------------------------------------------------
# Tryggport Dev — variáveis de ambiente
# Copie para `.env.local` (desenvolvimento) e gere segredos com:
#   npm run secrets:generate
# Nunca use prefixo NEXT_PUBLIC_ para segredos: ele os envia ao navegador.
# -----------------------------------------------------------------------------

# URL canônica do site (usada em SEO e na verificação de Origin das APIs).
SITE_URL=http://localhost:3000

# Driver do banco: "pg" (PostgreSQL real, obrigatório em produção) ou
# "pglite" (PostgreSQL em WebAssembly, apenas desenvolvimento/testes).
DATABASE_DRIVER=pglite
# Pasta de dados do PGlite (desenvolvimento).
PGLITE_DIR=./.data/pglite
# Conexão PostgreSQL (produção). Use SSL: ?sslmode=require
DATABASE_URL=

# Chave HMAC usada para gerar e verificar as respostas dos enigmas.
# 32+ bytes aleatórios em base64. Trocar a chave exige `npm run db:seed`.
PUZZLE_HMAC_KEY=

# Chave HMAC usada para anonimizar IPs nos limites de requisição.
IP_HASH_KEY=

# Confiar no cabeçalho X-Forwarded-For (true somente atrás de um proxy confiável,
# como a Vercel). Em false, o rate limit por IP usa um identificador genérico.
TRUST_PROXY=false
